  "pipeline": {
    "acts": [
      {
        "id": "act1", "num": "1/3", "title": "Tender → Matched Items",
        "goal": "Read the PDF and turn it into structured, matched, priceable items.",
        "steps": [
          { "id": "extract", "num": 1, "title": "Extract tender items", "desc": "Descriptions, quantities, units, technical details, source pages from the full LV.", "status": "todo", "owner": "P2" },
          { "id": "match", "num": 2, "title": "Match products", "desc": "Compare attributes against catalog.csv; assign a match confidence.", "status": "todo", "owner": "P2" },
          { "id": "route", "num": 3, "title": "Select pricing route", "desc": "Catalogue net cost or supplier quotation; mark status.", "status": "todo", "owner": "P2" }
        ]
      },
      {
        "id": "act2", "num": "2/3", "title": "Matched Items → Direct Costs",
        "goal": "Turn matches into traceable material and labour cost per position.",
        "steps": [
          { "id": "material", "num": 4, "title": "Calculate material cost", "desc": "Quantity × net unit cost × (1 + material waste %).", "status": "todo", "owner": "P3" },
          { "id": "labour", "num": 5, "title": "Calculate labour cost", "desc": "Base hours × quantity × project factors × hourly rate.", "status": "todo", "owner": "P3" },
          { "id": "combine", "num": 6, "title": "Combine item costs", "desc": "Material + labour per item; retain item and source-page references.", "status": "todo", "owner": "P3" }
        ]
      },
      {
        "id": "act3", "num": "3/3", "title": "Direct Costs → Price Variants",
        "goal": "Aggregate to a project price and (stretch) a recommended bid range.",
        "steps": [
          { "id": "projectcost", "num": 7, "title": "Build project cost", "desc": "Sum item costs; add services and allowances once.", "status": "todo", "owner": "P3" },
          { "id": "sellingprice", "num": 8, "title": "Calculate selling price", "desc": "(Direct costs + overhead) / (1 − target margin).", "status": "todo", "owner": "P3" },
          { "id": "variants", "num": 9, "title": "Generate variants", "desc": "Aggressive / Target / Conservative with margin + win probability.", "status": "todo", "owner": "P3" }
        ]
      }
    ]
  },
