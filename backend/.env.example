# ============================================================
#  Tender -> Preventivo  ·  backend/.env
#  NON committare questo file (e' in backend/.gitignore).
# ============================================================

# --- OpenAI -------------------------------------------------
# Incolla qui la chiave. Lascia vuoto per girare in modalita'
# puramente deterministica (nessuna chiamata AI).
OPENAI_API_KEY=

# --- Pipeline AI --------------------------------------------
# auto   = usa l'AI se OPENAI_API_KEY e' presente (default)
# off    = solo parser/matcher deterministici, zero chiamate
# forced = errore se manca la chiave (CI / run deliberati)
BANDO_AI_MODE=auto

# Estrazione posizioni dal PDF (Responses API + Structured Outputs).
# Default LUNA con effort none: nel benchmark 'none' ha battuto 'low'
# sia in accuratezza sia in latenza (vedi docs/benchmark.md).
BANDO_EXTRACT_MODEL=gpt-6-luna
BANDO_EXTRACT_EFFORT=none

# Match catalogo (Decisions API, solo gpt-6-luna supportato).
BANDO_MATCH_MODEL=gpt-6-luna

# Escalation selettiva sui casi dubbi.
BANDO_ESCALATE_MODEL=gpt-6-astra
BANDO_ESCALATE_EFFORT=medium

# --- Performance --------------------------------------------
# Pagine LV elaborate in parallelo. Abbassa se arrivano 429
# (tier "Build" = $500/mese di rate limit).
BANDO_AI_CONCURRENCY=8
BANDO_AI_TIMEOUT_S=120

# Massimo di chiamate di escalation per singola esecuzione.
# Esaurito il budget si torna al deterministico e si flagga,
# mai si blocca.
BANDO_ESCALATION_BUDGET=20

# --- Dataset / storage (default corretti, non toccare) ------
# BANDO_DATA_DIR=/Users/alessiogandelli/orca/projects/sprintd_zurich26/data
# BANDO_RUNTIME_DIR=/Users/alessiogandelli/orca/projects/sprintd_zurich26/backend/runtime
# BANDO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
